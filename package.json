{
  "name": "fde-spe-field-academy",
  "version": "3.4.0",
  "private": true,
  "description": "Portable source project for the independent FDE/SPE Field Academy learning website",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node work/build.mjs",
    "test": "node work/verify.mjs",
    "verify:package": "node work/check-package.mjs",
    "refresh:research": "node work/export-research.mjs",
    "build:site": "node work/build.mjs && node work/build-site.mjs",
    "deploy": "npm run build:site && wrangler deploy",
    "build:og": "node work/og-image.mjs",
    "refresh:jobs": "node work/fetch-jobs.mjs",
    "test:analytics": "node work/verify-analytics.mjs",
    "analytics:register": "node work/analytics/register-events.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "1.62.1"
  }
}
